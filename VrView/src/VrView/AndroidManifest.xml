<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Head tracking needs a gyroscope; declared optional so the app still installs without one. -->
  <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
  <uses-feature android:glEsVersion="0x00020000" android:required="true" />
  <!-- The browser and web videos; also follows the short link (goo.gl/…) printed on some viewers' QR codes. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Only Android 8–9 need it to save browser downloads in Descargas/VrView. -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
  <!-- No storage permission: folders are opened with the Storage Access Framework
       (the system folder picker), which grants persistent read access to that folder only. -->
  <application
      android:allowBackup="true"
      android:icon="@mipmap/appicon"
      android:roundIcon="@mipmap/appicon"
      android:label="@string/app_name"
      android:supportsRtl="true"
      android:localeConfig="@xml/locales_config"
      android:enableOnBackInvokedCallback="true"
      android:usesCleartextTraffic="true"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
  </application>
</manifest>
