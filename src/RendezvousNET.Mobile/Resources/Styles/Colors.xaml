<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="Accent">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <!-- Status colors matching the spec -->
    <Color x:Key="StatusGray">#94A3B8</Color>
    <Color x:Key="StatusGreen">#22C55E</Color>
    <Color x:Key="StatusYellow">#EAB308</Color>
    <Color x:Key="StatusRed">#EF4444</Color>

</ResourceDictionary>
